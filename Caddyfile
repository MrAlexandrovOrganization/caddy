(direct_listener) {
	servers :443 {
		protocols h1 h2 h3
	}
}

(edge_listener) {
	servers :443 {
		listener_wrappers {
			proxy_protocol {
				allow {$INGRESS_PROXY_CIDR:127.0.0.1/32}
				fallback_policy reject
				timeout 5s
			}
			tls
		}
	}
}

{
	metrics
	import {$CADDY_LISTENER_OPTIONS:direct_listener}
	# Credentials can occur anywhere in requests/responses. Omit those objects.
	log default {
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
			}
		}
	}
}

(local_proxy) {
	header_up Host {http.request.host}
}

(tls_origin) {
	header_up Host {args[0]}
	transport http {
		tls_server_name {args[0]}
	}
}

# Noise control and WebSocket upgrades require HTTP/1.1 on this TLS hop.
(tls_upgrade_origin) {
	header_up Host {args[0]}
	transport http {
		versions 1.1
		tls_server_name {args[0]}
	}
}

(safe_access) {
	log {
		output stdout
		level INFO
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				user_id delete
			}
		}
	}
	log_append service caddy
	log_append site {args[0]}
}

https://{$HEADSCALE_DOMAIN}, https://{$HEADSCALE_LEGACY_DOMAIN}:8443 {
	import safe_access headscale
	reverse_proxy {$HEADSCALE_UPSTREAM:headscale:8080} {
		import {$HEADSCALE_PROXY_OPTIONS:local_proxy} {$HEADSCALE_DOMAIN}
	}
}

# Match the actual TCP peer, never untrusted X-Forwarded-For headers.
(vpn_only) {
	@outside_vpn not remote_ip {$VPN_IPV4_CIDR} {$VPN_IPV6_CIDR}
	respond @outside_vpn "VPN access required" 403
}

# Explicit per-site migration setting; normal examples retain VPN-only access.
(public_access) {
	# Application authentication is still enforced by the upstream.
}

https://{$OPENCODE_DOMAIN} {
	import safe_access opencode
	import {$OPENCODE_ACCESS_POLICY:vpn_only}
	reverse_proxy {$OPENCODE_UPSTREAM:opencode-web-ingress:4096} {
		import {$OPENCODE_PROXY_OPTIONS:local_proxy} {$OPENCODE_DOMAIN}
	}
}

https://{$GRAFANA_DOMAIN} {
	import safe_access grafana
	import {$GRAFANA_ACCESS_POLICY:vpn_only}
	reverse_proxy {$GRAFANA_UPSTREAM:grafana-ingress:3000}
}

https://{$SUBSCRIPTIONS_DOMAIN} {
	import safe_access subscriptions
	reverse_proxy {$SUBSCRIPTIONS_UPSTREAM:publisher-ingress:8080} {
		import {$SUBSCRIPTIONS_PROXY_OPTIONS:local_proxy} {$SUBSCRIPTIONS_DOMAIN}
	}
}

# Worker API only; audio submission/client API remains private.
https://{$TRANSCRIBER_WORKERS_DOMAIN} {
	import safe_access transcriber-workers
	@worker_rpc {
		method POST
		path /whisper.WorkerService/*
	}
	@clip_worker_rpc {
		method POST
		path /embed.WorkerService/*
	}
	handle @clip_worker_rpc {
		request_body {
			max_size 20MB
		}
		reverse_proxy {$CLIP_WORKER_UPSTREAM:h2c://clip-embedder:50057} {
			import {$WORKERS_PROXY_OPTIONS:local_proxy} {$TRANSCRIBER_WORKERS_DOMAIN}
		}
	}
	@stash_worker_rpc {
		method POST
		path /stash.processing.v1.WorkerService/*
	}
	handle @stash_worker_rpc {
		request_body {
			max_size 20MB
		}
		reverse_proxy {$STASH_WORKER_UPSTREAM:h2c://stash:50058} {
			import {$WORKERS_PROXY_OPTIONS:local_proxy} {$TRANSCRIBER_WORKERS_DOMAIN}
		}
	}
	handle @worker_rpc {
		request_body {
			max_size 8MB
		}
		reverse_proxy {$TRANSCRIBER_WORKER_UPSTREAM:h2c://transcriber-worker-api:50056} {
			import {$TRANSCRIBER_WORKER_PROXY_OPTIONS:local_proxy} {$TRANSCRIBER_WORKERS_DOMAIN}
		}
	}
	handle {
		respond 404
	}
}

# Bind only the dedicated metrics interface; do not expose the admin API.
http://:9180 {
	bind caddy-metrics
	handle /metrics {
		metrics
	}
	handle {
		respond 404
	}
}
