[Unit]
Description=Refresh the personality site snapshot from Google Sheets
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=%i
WorkingDirectory=/home/%i/projects/infra/network/caddy
ExecStart=/usr/bin/make personality-sync
TimeoutStartSec=90s
UMask=0077
