HEADSCALE_DOMAIN=headscale.example.com
HEADSCALE_LEGACY_DOMAIN=vpn.example.com
OPENCODE_DOMAIN=opencode.example.com
GRAFANA_DOMAIN=grafana.example.com
SUBSCRIPTIONS_DOMAIN=subscriptions.example.com
VPN_IPV4_CIDR=100.64.0.0/10
VPN_IPV6_CIDR=fd7a:115c:a1e0::/48
TRANSCRIBER_WORKERS_DOMAIN=workers.example.com
OPENCODE_ACCESS_POLICY=vpn_only
GRAFANA_ACCESS_POLICY=vpn_only

# Optional remote Grafana host:port; default is grafana-ingress:3000.
GRAFANA_UPSTREAM=grafana-ingress:3000

# Russia: edge_listener; allow only the actual private vpn-ingress subnet.
# CADDY_LISTENER_OPTIONS=edge_listener
# INGRESS_PROXY_CIDR=192.0.2.0/24
# For a remote upstream use https://ORIGIN_IP and tls_origin options.
# OPENCODE_UPSTREAM=https://192.0.2.1
# OPENCODE_PROXY_OPTIONS=tls_origin
# SUBSCRIPTIONS_UPSTREAM=https://192.0.2.1
# SUBSCRIPTIONS_PROXY_OPTIONS=tls_origin
# CLIP_WORKER_UPSTREAM=https://192.0.2.1
# STASH_WORKER_UPSTREAM=https://192.0.2.1
# TRANSCRIBER_WORKER_UPSTREAM=https://192.0.2.1
# WORKERS_PROXY_OPTIONS=tls_origin
# Original host after cutover: HEADSCALE_UPSTREAM=https://RUSSIA_PUBLIC_IP
# HEADSCALE_PROXY_OPTIONS=tls_origin
